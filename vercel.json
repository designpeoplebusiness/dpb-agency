{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/assets/og.png", "destination": "https://card.dpb.agency/assets/dpb/og.png" },
    { "source": "/assets/icon-48.png", "destination": "https://card.dpb.agency/assets/dpb/icon-48.png" },
    { "source": "/assets/icon-192.png", "destination": "https://card.dpb.agency/assets/dpb/icon-192.png" },
    { "source": "/assets/icon-512.png", "destination": "https://card.dpb.agency/assets/dpb/icon-512.png" },
    { "source": "/assets/apple-touch-icon.png", "destination": "https://card.dpb.agency/assets/dpb/apple-touch-icon.png" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
